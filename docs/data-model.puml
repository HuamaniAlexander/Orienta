@startuml
entity institutions {
  * id : integer <<PK>>
  * name : varchar <<unique>>
}
entity academic_offers {
  * id : varchar <<PK>>
  * institution_id : integer <<FK>>
  * import_id : integer <<FK>>
  * identity_key : text <<unique>>
  name : varchar
  modality : varchar
  location : varchar
  duration_months : integer <<nullable, positive>>
  monthly_cost_pen : numeric <<nullable, nonnegative>>
  active : boolean
}
entity sources {
  * id : integer <<PK>>
  * offer_id : varchar <<FK>>
  field : varchar
  reference : text <<nullable>>
  status : text
}
entity imports {
  * id : integer <<PK>>
  * sha256 : varchar <<unique>>
  imported_at : timestamp
  row_count : integer
}
institutions ||--o{ academic_offers
imports ||--o{ academic_offers
academic_offers ||--o{ sources
@enduml
