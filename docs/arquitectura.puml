@startuml
actor Visitante
component "React / Fetch" as React
component "HTTP FastAPI\nadapters/input" as HTTP
component "Casos de uso\napplication" as UC
component "Entidades y reglas\ndomain" as Domain
interface "RepositorioCarreras\nports" as Port
component "SQLAlchemy\nadapters/output" as SQL
component "Excel\nadapters/output" as Excel
database PostgreSQL
Visitante --> React
React --> HTTP
HTTP --> UC
UC --> Domain
UC --> Port
SQL ..|> Port
SQL --> PostgreSQL
Excel --> Domain
@enduml
